{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "monokai"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "sounds": {
      "done": "/System/Library/Sounds/Purr.aiff"
    }
  },
  "mouse": false,
  "keybinds": {
    "app.exit": ["ctrl+c"],
    "app.debug": false,
    "app.clear": "ctrl+l",
    "session.tab.next": "<leader>]",
    "session.tab.previous": "<leader>[",
    "session.rename": "<leader>r",
    "session.delete": "<leader>q",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "diff.half_page.up": "ctrl+alt+u",
    "diff.half_page.down": "ctrl+alt+d",
    "input.delete": false,
    "input.delete.to.line.start": false,
    "composer.subagent.interrupt": "alt+d",
    "composer.shell.kill": "alt+k",
    "model.dialog.usage": false,
    "queued_prompt.undo": false,
    "queued_prompt.delete": false,
    "dialog.plugins.update": false,
    "dialog.integration.delete": false,
    "dialog.move_session.delete": false,
    "terminal.toggle": false,
    "stash.delete": false
  },
  "leader": {
    "timeout": 1500
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "submit_scroll": "bottom",
    "thinking": "hide",
    "markdown": "rendered",
    "verbosity": "low",
    "tps": true,
    "permissions": "prompt"
  }
}
