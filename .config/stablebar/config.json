{
  "$schema": "https://raw.githubusercontent.com/Seb-GRAF/StableBar/v0.15.0/stablebar.schema.json",
  "bar": {
    "offset": 0,
    "belowMenuBar": false,
    "keepWindowsClear": false,
    "appearance": null,
    "motion": "none",
    "popupTransition": "fade",
    "morphPopups": true,
    "inlineHoverControls": false,
    "menuBarRevealDelay": 200,
    "hideMenuBar": false,
    "glass": {
      "enabled": false
    },
    "position": "top",
    "style": {
      "states": {
        "mode.service": {
          "borderEdges": "bottom",
          "borderColor": "@token.warning",
          "borderWidth": 2
        }
      }
    }
  },
  "includes": ["sketchybar-app-font.json"],
  "widgets": [
    {
      "id": "apple",
      "position": "left",
      "type": "appleMenu",
      "style": {
        "borderWidth": 0,
        "paddingHorizontal": 8,
        "paddingVertical": 6,
        "fontSize": 14
      }
    },
    {
      "id": "workspaces",
      "position": "left",
      "type": "workspaces",
      "workspace": {
        "windows": true,
        "magnification": null,
        "indicator": "background",
        "indicatorStyle": {
          "placement": "cell",
          "background": "@token.textMuted",
          "offsetY": 0
        },
        "style": {
          "height": 22,
          "paddingHorizontal": 6,
          "fontSize": 12,
          "foreground": "@token.text"
        },
        "badges": "count",
        "focusedWindowStyle": null,
        "appGlyphs": "@token.appGlyphs",
        "appStyle": {
          "fontName": "sketchybar-app-font",
          "fontSize": 14
        }
      },
      "style": {
        "states": {
          "hover": {
            "background": null
          }
        },
        "fontName": "system",
        "paddingVertical": 3,
        "paddingHorizontal": 2,
        "borderWidth": 0,
        "accent": "@token.accent",
        "fontSize": 14
      },
      "display": ["builtIn", "monitor", "vertical"],
      "tooltipBackground": "@token.surfaceRaised"
    },
    {
      "id": "app-menu",
      "position": "left",
      "type": "appMenu",
      "expandOnHover": true,
      "popupBackground": "@token.surfaceRaised",
      "display": ["builtIn", "monitor", "vertical"],
      "style": {
        "fontWeight": "regular"
      }
    },
    {
      "id": "meeting",
      "layout": {
        "children": [
          {
            "source": "icon",
            "type": "symbol"
          },
          {
            "field": "text",
            "type": "field"
          },
          {
            "field": "start",
            "hideWhenEmpty": "start",
            "role": "secondary",
            "type": "field"
          }
        ],
        "type": "row"
      },
      "popup": {
        "layout": {
          "children": [
            {
              "role": "heading",
              "text": "Today",
              "type": "text"
            },
            {
              "row": {
                "children": [
                  {
                    "field": "start",
                    "role": "key",
                    "style": {
                      "width": 56
                    },
                    "type": "field"
                  },
                  {
                    "field": "title",
                    "role": "primary",
                    "type": "field"
                  }
                ],
                "openField": "link",
                "type": "row"
              },
              "source": "today",
              "type": "list"
            },
            {
              "role": "separator",
              "type": "divider"
            },
            {
              "open": "com.apple.iCal",
              "role": "button",
              "text": "Calendar",
              "type": "text"
            }
          ],
          "type": "column"
        },
        "style": {
          "width": 320
        },
        "openOnHover": true
      },
      "position": "right",
      "type": "calendar",
      "display": ["builtIn", "monitor", "vertical"],
      "icon": ""
    },
    {
      "id": "sound",
      "type": "audio",
      "position": "right",
      "display": ["vertical"]
    },
    {
      "details": true,
      "id": "battery",
      "position": "right",
      "type": "battery",
      "layout": null
    },
    {
      "id": "widget-58701978",
      "position": "right",
      "type": "inputSource",
      "display": "all",
      "icon": ""
    },
    {
      "format": "EEE d MMM  HH:mm",
      "id": "clock",
      "onClick": "open -a Calendar",
      "position": "right",
      "type": "clock"
    },
    {
      "id": "menu-bar-items",
      "position": "right",
      "type": "menuBarItems",
      "shown": [
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.controlcenter"
        }
      ],
      "hidden": [
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.sound"
        },
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.battery"
        },
        {
          "app": "com.apple.TextInputMenuAgent"
        },
        {
          "app": "timeow-mac_arm64"
        },
        {
          "app": "com.jordanbaird.Ice"
        },
        {
          "app": "com.apple.weather.menu"
        },
        "symbol",
        {
          "app": "com.apple.controlcenter",
          "item": "com.apple.menuextra.clock"
        },
        {
          "app": "bobko.aerospace"
        }
      ],
      "display": ["vertical"]
    },
    {
      "id": "widget-6f7392b2",
      "position": "notchRight",
      "type": "privacy",
      "hideWhenIdle": true
    }
  ],
  "packages": [
    {
      "enabled": true,
      "id": "now-playing",
      "settings": {
        "barWidth": 160
      },
      "version": "1.2.2"
    },
    {
      "enabled": true,
      "id": "weather",
      "settings": {
        "location": "",
        "units": "metric"
      },
      "version": "1.0.3"
    }
  ],
  "widgetOrder": [
    "apple",
    "workspaces",
    "app-menu",
    "weather",
    "meeting",
    "sound",
    "battery",
    "widget-58701978",
    "clock",
    "menu-bar-items",
    "widget-6f7392b2",
    "now-playing"
  ],
  "widgetOverrides": {
    "now-playing": {
      "enabled": true,
      "position": "center",
      "display": "all"
    },
    "weather": {
      "enabled": true,
      "position": "right",
      "display": ["builtIn", "monitor", "vertical"],
      "popup": {
        "openOnHover": true
      },
      "icon": ""
    }
  },
  "workspaceSource": "aerospace",
  "screens": {
    "laptop": {
      "layout": {
        "center": ["now-playing"],
        "left": ["apple", "workspaces", "app-menu"],
        "notchLeft": [],
        "notchRight": ["widget-6f7392b2"],
        "right": ["weather", "meeting", "battery", "widget-58701978", "clock"]
      }
    },
    "monitor": {
      "layout": {
        "center": ["now-playing"],
        "left": ["apple", "workspaces", "app-menu"],
        "notchLeft": [],
        "notchRight": ["widget-6f7392b2"],
        "right": ["weather", "meeting", "battery", "widget-58701978", "clock"]
      }
    }
  },
  "modeAliases": {
    "service": "service"
  },
  "theme": {
    "id": "grey-round",
    "version": "1.0.0"
  }
}
