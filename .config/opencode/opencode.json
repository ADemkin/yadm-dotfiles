    },
    {
      "action": "gitlab_resolve_merge_request_thread",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "gitlab_update_issue",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "gitlab_update_issue_description_patch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "gitlab_update_merge_request",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "kubernetes_pods_delete",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "kubernetes_pods_exec",
      "resource": "*",
      "effect": "deny"
